        </mxCell>
        <mxCell id="m-client" value="HabitServiceClient&#10;[Component]&#10;HTTP-вызов habit-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m-controller" value="TrackingController&#10;[Component]&#10;HTTP-маршруты GET/POST /trackings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
