        <mxCell id="me4" value="проверяет привычку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="m-controller" target="m-client">
