          <mxGeometry x="430" y="430" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m-dto1" value="CreateTrackingRequest&#10;[Component: DTO]&#10;входные данные + валидация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="270" width="230" height="70" as="geometry"/>
