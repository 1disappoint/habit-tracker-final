      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c-sys" value="Habit Tracker System&#10;[Software System]&#10;Система учёта привычек и их выполнения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="180" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c-user" value="Пользователь&#10;[Person]&#10;Работает через HTTP API" style="shape=person;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="190" width="90" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c-db" value="PostgreSQL&#10;[External System]&#10;Хранение данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="195" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTP / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-user" target="c-sys">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-sys" target="c-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-legend" value="C4 Level 1: System Context — система как «чёрный ящик»" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="600" height="30" as="geometry"/>
