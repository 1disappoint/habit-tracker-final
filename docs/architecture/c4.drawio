        <mxCell id="m-dto2" value="Tracking&#10;[Component: DTO]&#10;модель ответа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="370" width="230" height="70" as="geometry"/>
        </mxCell>
